# Copy these into Vercel -> Settings -> Environment Variables.
# Event Planner uses the SAME Supabase project as the OTG Control Centre ("OTG Shared"),
# so these are the same values you used for the Control Centre.

# Supabase project address and public key (safe to show in the browser)
VITE_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=your-anon-or-publishable-key
SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
SUPABASE_PUBLISHABLE_KEY=your-anon-or-publishable-key

# Secret admin key. Never share it or put it in a VITE_ variable.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-or-secret-key

# Claude key for "Ask" answers on plans (the same key the Control Centre uses).
ANTHROPIC_API_KEY=your-anthropic-api-key

# Optional. Which Claude model answers questions. Leave out to use the default.
# ASK_MODEL=claude-opus-5-5

# Optional. Where people sign in (the Control Centre). This is the default.
# VITE_CONTROL_CENTRE_URL=https://controlcentre.outthereadmin.com.au

# Not needed: Event Planner sends no emails of its own. Invites and password
# emails come from the Control Centre.
